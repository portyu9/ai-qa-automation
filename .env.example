# Reference configuration only. The runtime deliberately does NOT auto-load .env files;
# export values explicitly in the shell/runner or inject them through your secret manager.

# Required only for live Claude-backed execution. Never commit a real key.
ANTHROPIC_API_KEY=
AI_QA_MODEL=claude-sonnet-5

# Trusted agent repository root. Defaults to the current working directory.
AI_QA_CONTROL_ROOT=
# Trusted run/evidence root. Defaults to <control-root>/artifacts.
AI_QA_ARTIFACT_ROOT=

# Optional explicit Git baseline for PR/feature-branch change intelligence.
# Example: origin/main. Resolved to immutable baseline + merge-base SHAs at runtime.
AI_QA_BASE_REF=

# Optional official MCP integrations. Never commit real credentials.
GITHUB_PERSONAL_ACCESS_TOKEN=
AI_QA_ENABLE_GITHUB_MCP=false
AI_QA_ENABLE_ATLASSIAN_MCP=false

# Safety defaults
AI_QA_REGULATED_MODE=false
AI_QA_ALLOW_EXTERNAL_NETWORK=false
# External API/browser DNS names and global IP literals additionally require trusted
# deployment enforcement of post-resolution outbound destinations. This flag is only
# an environment-owned prerequisite assertion; it does NOT implement DNS pinning,
# a firewall, a proxy, or an egress namespace by itself.
AI_QA_API_BROWSER_EXTERNAL_EGRESS_ENFORCED=false
# Pydantic JSON list of explicit hostnames/IP literals only (no URLs, ports, or wildcards).
# localhost/loopback only by default. API/browser execution rejects private, link-local,
# multicast, reserved, unspecified, and other non-global literals even if allowlisted;
# non-canonical legacy numeric IP spellings are rejected at configuration ingestion.
AI_QA_ALLOWED_NETWORK_HOSTS=["127.0.0.1","localhost"]
AI_QA_ALLOW_TEST_WRITES=false
# Legacy compatibility tripwire only. Generic API mutation has no autonomous runtime authority;
# setting this true is rejected during trusted Settings validation.
AI_QA_ALLOW_MUTATING_API_METHODS=false
# Required before the live Agent SDK path may execute target-controlled pytest code.
# These assert deployment-enforced process/filesystem containment and outbound-egress
# enforcement; the flags themselves do NOT implement a sandbox, firewall, or namespace.
AI_QA_PYTEST_PROCESS_ISOLATION_ENFORCED=false
AI_QA_PYTEST_EXTERNAL_EGRESS_ENFORCED=false
# Required for every live k6 attempt. This asserts only deployment-enforced outbound
# containment; the flag itself is NOT a firewall. K6 process spawn additionally requires
# trusted process/filesystem isolation, executable module-loading isolation, bounded runner
# CPU/memory/process resources, and bounded target workload/concurrency/rate enforcement.
# The current live MCP configuration exposes none of those four additional assertions, so
# live k6 remains fail-closed pending trusted containment plumbing.
AI_QA_K6_EXTERNAL_EGRESS_ENFORCED=false

# Independent execution/model budgets
AI_QA_MAX_TURNS=12
AI_QA_MAX_TOOL_CALLS=30
AI_QA_MAX_NETWORK_CALLS=12
AI_QA_MAX_MUTATIONS=3
AI_QA_MAX_REPEATED_ACTION=3
# Transient Agent SDK recovery is permitted only for replay-safe session-start failures
# before provider query submission. 2 retries = at most 3 startup attempts under the same
# run timeout, lease, evidence/journal lineage, and framework budgets.
AI_QA_MAX_SDK_RETRIES=2
AI_QA_SDK_RETRY_BACKOFF_SECONDS=1.0
AI_QA_SDK_RETRY_MAX_BACKOFF_SECONDS=4.0
AI_QA_TOOL_TIMEOUT_SECONDS=120
AI_QA_GLOBAL_TIMEOUT_SECONDS=600
AI_QA_MAX_COST_USD=5.0
