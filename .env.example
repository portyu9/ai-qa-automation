# Required only for live Claude-backed execution.
ANTHROPIC_API_KEY=
AI_QA_MODEL=claude-sonnet-5

# Trusted agent repository root. Defaults to repository root.
AI_QA_CONTROL_ROOT=

# Optional official MCP integrations. Never commit real credentials.
GITHUB_PERSONAL_ACCESS_TOKEN=
AI_QA_ENABLE_GITHUB_MCP=false
AI_QA_ENABLE_ATLASSIAN_MCP=false

# Safety defaults
AI_QA_REGULATED_MODE=false
AI_QA_ALLOW_EXTERNAL_NETWORK=false
# Pydantic JSON list; localhost only by default. Add approved staging hosts explicitly.
AI_QA_ALLOWED_NETWORK_HOSTS=["127.0.0.1","localhost"]
AI_QA_ALLOW_TEST_WRITES=false
AI_QA_ALLOW_MUTATING_API_METHODS=false
AI_QA_K6_EXTERNAL_EGRESS_ENFORCED=false
AI_QA_MAX_TURNS=12
AI_QA_MAX_TOOL_CALLS=30
AI_QA_TOOL_TIMEOUT_SECONDS=120
AI_QA_GLOBAL_TIMEOUT_SECONDS=600
