# Reference configuration only. The runtime deliberately does NOT auto-load .env files;
# export values explicitly in the shell/runner or inject them through your secret manager.

# Required only for live Claude-backed execution. Never commit a real key.
ANTHROPIC_API_KEY=
AI_QA_MODEL=claude-sonnet-5

# Trusted agent repository root. Defaults to the current working directory.
AI_QA_CONTROL_ROOT=
# Trusted run/evidence root. Defaults to <control-root>/artifacts.
AI_QA_ARTIFACT_ROOT=

# Optional explicit Git baseline for PR/feature-branch change intelligence.
# Example: origin/main. Resolved to immutable baseline + merge-base SHAs at runtime.
AI_QA_BASE_REF=

# Optional official MCP integrations. Never commit real credentials.
GITHUB_PERSONAL_ACCESS_TOKEN=
AI_QA_ENABLE_GITHUB_MCP=false
AI_QA_ENABLE_ATLASSIAN_MCP=false

# Safety defaults
AI_QA_REGULATED_MODE=false
AI_QA_ALLOW_EXTERNAL_NETWORK=false
# Pydantic JSON list of explicit hostnames/IP literals only (no URLs, ports, or wildcards).
# localhost only by default; add approved non-production hosts deliberately.
AI_QA_ALLOWED_NETWORK_HOSTS=["127.0.0.1","localhost"]
AI_QA_ALLOW_TEST_WRITES=false
AI_QA_ALLOW_MUTATING_API_METHODS=false
AI_QA_K6_EXTERNAL_EGRESS_ENFORCED=false

# Independent execution/model budgets
AI_QA_MAX_TURNS=12
AI_QA_MAX_TOOL_CALLS=30
AI_QA_MAX_NETWORK_CALLS=12
AI_QA_MAX_MUTATIONS=3
AI_QA_MAX_REPEATED_ACTION=3
AI_QA_TOOL_TIMEOUT_SECONDS=120
AI_QA_GLOBAL_TIMEOUT_SECONDS=600
AI_QA_MAX_COST_USD=5.0
